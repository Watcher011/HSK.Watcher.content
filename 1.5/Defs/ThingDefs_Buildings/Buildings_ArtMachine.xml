<?xml version="1.0" encoding="utf-8" ?>
<Defs>


<ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
		<!--<defName>FermentingBarrel</defName>-->
		<defName>CNCmachine</defName>
		<label>CNC machine</label>
		<description>Requires a qualified operator for setup and maintenance. In skilled hands, it can create real masterpieces that decorate palaces, temples and squares.</description>
		<graphicData>
			  <texPath>Things/Building/ProductionLab/ProductionLab</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(2,1)</drawSize>
			<shadowData>
				<volume>(2.22, 0.8, 0.62)</volume>
				<offset>(0, 0, -0.13)</offset>
			</shadowData>
			<damageData>
				<rect>(0.3,0.1,2.4,1.8)</rect>
			</damageData>
		</graphicData>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsProduction</li>
		</thingCategories>
		<fillPercent>0.55</fillPercent>
		<pathCost>60</pathCost>
		<statBases>
			<WorkToBuild>900</WorkToBuild>
			<Mass>50</Mass>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
		</statBases>
			<stuffCategories>
			<li>StrongMetallic</li>
			<li>Ceramic</li>
		</stuffCategories>
		<costStuffCount>90</costStuffCount>
		<costList>
			<ComponentMedieval>2</ComponentMedieval>
		</costList>
		<size>(2,1)</size>
		<rotatable>true</rotatable>
		<designationCategory>Production</designationCategory>
		<tickerType>Rare</tickerType>
		<building>
			<uninstallWork>150</uninstallWork>
		</building>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>Small_ToolCabinet</li>
				</linkableFacilities>
			</li>
		</comps>
		<researchPrerequisites>
			<li>MicroelectronicsBasics</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>

		<!-- ThingDef_UF fields -->
		<showProductIcon>true</showProductIcon>
		<barOffset>(0.0, 0.25)</barOffset>
		<barScale>(1.0, 1.0)</barScale>
		<slotsCount>1</slotsCount>
	</ThingDef>
	
	<!--================================ Building_CNC_Art ======================================-->
	
	<ThingDef ParentName="SK_BuildingBase" Name="AdvanceCNCArtBase" Abstract="True">
		<thingClass>Building_Art</thingClass>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.9</fillPercent>
		<pathCost>70</pathCost>
		<useHitPoints>true</useHitPoints>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsArt</li>
		</thingCategories>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
		</thingSetMakerTags>
		<statBases>
			<Flammability>1.0</Flammability>
			<SellPriceFactor>1.10</SellPriceFactor>
			<MeditationFocusStrength>0.0</MeditationFocusStrength>
		</statBases>
		<comps>
			<li Class="CompProperties_MeditationFocus">
				<statDef>MeditationFocusStrength</statDef>
				<focusTypes>
					<li>Artistic</li>
				</focusTypes>
				<offsets>
					<li Class="FocusStrengthOffset_Quality">
						<curve>
							<points>
								<li>(0,0.12)</li>
								<!-- awful -->
								<li>(1,0.16)</li>
								<!-- poor -->
								<li>(2,0.20)</li>
								<!-- normal -->
								<li>(3,0.22)</li>
								<!-- good -->
								<li>(4,0.24)</li>
								<!-- excellent -->
								<li>(5,0.26)</li>
								<!-- masterwork -->
								<li>(6,0.28)</li>
								<!-- legendary -->
							</points>
						</curve>
					</li>
					<li Class="FocusStrengthOffset_BuildingDefsWithQuality">
						<defs>
							<li>SculptureSmall</li>
							<li>SculptureLarge</li>
							<li>SculptureGrand</li>
							<li>MuffaloArt</li>
							<li>QueenArt</li>
							<li>NymphArt</li>
							<li>GreenyArt</li>
							<li>WolfArt</li>
							<li>DragonArt</li>
							<li>ZeonArt</li>							
							<li>DecorativeUrnSmall</li>
							<li>SmallPottery</li>
						</defs>
						<radius>9.9</radius>
						<maxBuildings>8</maxBuildings>
						<focusPerQuality>
							<points>
								<li>(0,0.0)</li>
								<!-- awful -->
								<li>(1,0.0)</li>
								<!-- poor -->
								<li>(2,0.01)</li>
								<!-- normal -->
								<li>(3,0.01)</li>
								<!-- good -->
								<li>(4,0.01)</li>
								<!-- excellent -->
								<li>(5,0.02)</li>
								<!-- masterwork -->
								<li>(6,0.02)</li>
								<!-- legendary -->
							</points>
						</focusPerQuality>
						<explanationKey>MeditationFocusPerSculpture</explanationKey>
						<explanationKeyAbstract>MeditationFocusPerSculptureAbstract</explanationKeyAbstract>
					</li>
				</offsets>
			</li>
			<li Class="CompProperties_Styleable"/>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_MeditationOffsetBuildingsNear</li>
		</placeWorkers>
		<building>
			<uninstallWork>600</uninstallWork>
			<paintable>true</paintable>
		</building>
		<inspectorTabs>
			<li>ITab_Art</li>
		</inspectorTabs>
		<tradeTags>
			<li>Art</li>
		</tradeTags>
		<ideoBuildingNamerBase MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoSculpture</ideoBuildingNamerBase>
		<ritualFocus>
			<spectateDistance>2</spectateDistance>
			<allowedSpectateSides>Down</allowedSpectateSides>
		</ritualFocus>
	</ThingDef>


