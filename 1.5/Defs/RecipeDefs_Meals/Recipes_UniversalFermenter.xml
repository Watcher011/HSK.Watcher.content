		<temperatureSafe>
			<min>5</min>
			<max>80</max>
		</temperatureSafe>
		<temperatureIdeal>
			<min>18</min>
			<max>50</max>
		</temperatureIdeal>
		<processDays>6</processDays>
		<speedBelowSafe>0.05</speedBelowSafe>
		<speedAboveSafe>0.8</speedAboveSafe>
		<sunFactor>
			<min>0.75</min>
			<max>1.2</max>
		</sunFactor>
		<rainFactor>
			<min>1</min>
			<max>0</max>
		</rainFactor>
