<?xml version="1.0" encoding="UTF-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Survival Tools Lite</li>
    </mods>
    <match Class="PatchOperationSequence">
		<operations>
	
			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[defName="YadaritBar"]</xpath>
				<value>
					<li Class="SurvivalToolsLite.StuffPropsTool">
						<toolStatFactors>
							<TreeFellingSpeed>0.4</TreeFellingSpeed>
							<PlantHarvestingSpeed>0.3</PlantHarvestingSpeed>
							<PlantWorkSpeed>0.45</PlantWorkSpeed>
							<MiningSpeed>0.4</MiningSpeed>
							<MiningYieldDigging>0.5</MiningYieldDigging>
							<ConstructionSpeed>0.5</ConstructionSpeed>
						</toolStatFactors>
						<wearFactorMultiplier>0.6</wearFactorMultiplier>
					</li>
				</value>
			</li>
	
			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[defName="Amber"]</xpath>
				<value>
					<li Class="SurvivalToolsLite.StuffPropsTool">
						<toolStatFactors>
							<TreeFellingSpeed>0.3</TreeFellingSpeed>
							<PlantHarvestingSpeed>0.2</PlantHarvestingSpeed>
							<PlantWorkSpeed>0.2</PlantWorkSpeed>
							<MiningSpeed>0.3</MiningSpeed>
							<MiningYieldDigging>0.3</MiningYieldDigging>
							<ConstructionSpeed>0.4</ConstructionSpeed>
						</toolStatFactors>
						<wearFactorMultiplier>0.7</wearFactorMultiplier>
					</li>
				</value>
			</li>
		
	
		</operations>
    </match>
  </Operation>

</Patch>
