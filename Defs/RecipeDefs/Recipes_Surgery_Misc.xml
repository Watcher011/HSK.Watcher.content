<?xml version="1.0" encoding="utf-8" ?>
<Defs>


   <RecipeDef>
    <defName>TreatmentOfInfection</defName>
    <label>Treatment of infection</label>
    <description>Carrying out a wide range of procedures to combat infection.</description>
    <workerClass>Recipe_RemoveHediff</workerClass>
    <jobString>Treats infection TargetA.</jobString>
    <successfullyRemovedHediffMessage>{0} has successfully cured the infection on {1}.</successfullyRemovedHediffMessage>
	 <workAmount>500</workAmount>
        <workSkillLearnFactor>1</workSkillLearnFactor>
        <effectWorking>Surgery</effectWorking>
        <soundWorking>Recipe_Surgery</soundWorking>
        <workSpeedStat>MedicalOperationSpeed</workSpeedStat>
        <workSkill>Medicine</workSkill>
    <removesHediff>WoundInfection</removesHediff>
	 <surgerySuccessChanceFactor>0.95</surgerySuccessChanceFactor>
	 <deathOnFailedSurgeryChance>0.05</deathOnFailedSurgeryChance>
	 <skillRequirements>
      <Medicine>4</Medicine>
    </skillRequirements>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Bandagekitcrude</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
	  <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
	  <li>
		<filter>
			<thingDefs>
            <li>HemogenPack</li>
          </thingDefs>
			</filter>
			<count>1</count>
	   </li>
    </ingredients>
	 <fixedIngredientFilter>
            <categories>
                <li>Medicine</li>
            </categories>
            <thingDefs>
              <li>HemogenPack</li>
              <li>Bandagekitcrude</li>
            </thingDefs>  
        </fixedIngredientFilter>
  </RecipeDef>

</Defs>
