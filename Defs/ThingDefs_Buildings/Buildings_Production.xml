<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Drying Rack -->
	<ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
		<defName>industrialDryingRack</defName>
		<label>industrial drying rack</label>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Production/industrialDryingRack</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(2,1)</drawSize>
			<shadowData>
				<volume>(1.7, 0.5, 0.7)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsProduction</li>
		</thingCategories>
		<fillPercent>0.45</fillPercent>
		<pathCost>60</pathCost>
		<statBases>
			<WorkToBuild>800</WorkToBuild>
			<Mass>20</Mass>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Cleanliness>-3</Cleanliness>
		</statBases>
		<description>The dryer (industrial) is designed for drying berries, meat, mushrooms, fish..</description>
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<costStuffCount>60</costStuffCount>
		<costList>
			<ComponentIndustrial>7</ComponentIndustrial>
			<ElectronicComponents>4</ElectronicComponents>
			<Mechanism>5</Mechanism>
			<Glass>25</Glass>
		</costList>
		<size>(2,1)</size>
		<building>
			<uninstallWork>650</uninstallWork>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>800</basePowerConsumption>
				<shortCircuitInRain>true</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<tickerType>Rare</tickerType>
		<rotatable>true</rotatable>
		<designationCategory>Production</designationCategory>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>

		<!-- ThingDef_UF fields -->
		<showProductIcon>false</showProductIcon>
		<barOffset>(0.0, -0.35)</barOffset>
		<barScale>(1.0, 1.0)</barScale>
		<slotsCount>60</slotsCount>
		
		<researchPrerequisites>
			<li>Food_C1</li>
		</researchPrerequisites>
		
	</ThingDef>
    <ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
		<defName>CharcoalPit</defName>
		<label>Charcoal Pit</label>
		<graphicData>
			<texPath>Things/Building/CharcoalPit/Charcoal_pit</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,3)</drawSize>
			<shadowData>
				<volume>(0, 0, 0)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/CharcoalPit/Charcoal_UI</uiIconPath>
		<costList>
			<WoodLog>25</WoodLog>
		</costList>
		<fillPercent>0.01</fillPercent>
		<pathCost>60</pathCost>
		<statBases>
			<WorkToBuild>8200</WorkToBuild>
			<MaxHitPoints>300</MaxHitPoints>
			<Flammability>0.0</Flammability>
			<Beauty>-50</Beauty>
			<Cleanliness>-100</Cleanliness>
		</statBases>
		<description>Saltpeter pit.</description>
		<size>(3,3)</size>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>21</heatPerSecond>
        <heatPushMaxTemperature>28</heatPushMaxTemperature>
      </li>
	   <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
		</comps>
		<tickerType>Rare</tickerType>
		<rotatable>true</rotatable>
		<constructionSkillPrerequisite>2</constructionSkillPrerequisite>
		<designationCategory>Production</designationCategory>
		<researchPrerequisites>
			<li>RecurveBow</li>
		</researchPrerequisites>

		<!-- ThingDef_UF fields -->
		<showProductIcon>true</showProductIcon>
		<barOffset>(0.0, 0.25)</barOffset>
		<barScale>(1.0, 1.0)</barScale>
		<slotsCount>10</slotsCount>
	</ThingDef>
</Defs>
